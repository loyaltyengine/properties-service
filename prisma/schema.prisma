generator client {
  provider     = "prisma-client"
  output       = "../src/database/gen"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id              String         @id @default(uuid())
  createdByUserId String         @map("created_by_user_id")
  name            String         @map("name")
  description     String?        @map("description")
  type            PropertyType   @default(OTHER) @map("type")
  domain          String?        @map("domain")
  email           String?        @map("email")
  status          PropertyStatus @default(ACTIVE) @map("status")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  users PropertyUser[]

  @@map("properties")
}

model PropertyUser {
  id               String   @id @default(uuid()) @map("id")
  propertyId       String   @map("property_id")
  userId           String   @map("user_id")
  role             UserRole @default(VIEWER) @map("role")
  assignedAt       DateTime @default(now()) @map("assigned_at")
  assignedByUserId String   @map("assigned_by_user_id")
  updatedAt        DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@map("property_users")
}

enum PropertyType {
  WEBSITE
  APP
  ORGANIZATION
  OTHER
}

enum PropertyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}
